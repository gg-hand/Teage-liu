{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "teage-liu2/protocol/lifecycle/v1.0.0",
  "title": "lifecycle 域 — 生命周期与扩展声明",
  "description": "扩展生命周期协议(setup/teardown/热重载/进程重建)与扩展声明模型。",
  "definitions": {
    "ProtocolVersion": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
      "description": "semver 版本号, 如 'v1.0.0'。"
    },
    "TransportType": {
      "enum": ["stdio", "in-process"],
      "description": "stdio=跨进程(异语言)唯一通道; in-process=同语言进程内绑定(消息语义零成本实现)。"
    },
    "Capability": {
      "type": "string",
      "enum": ["observe", "tool_executor", "llm", "self_hosted_storage"],
      "description": "扩展能力声明集合元素。observe=观测只读; tool_executor=工具执行者; llm=可调 invoke_llm; self_hosted_storage=自持存储。"
    },
    "ExtensionManifest": {
      "type": "object",
      "description": "manifest.yaml 安装态声明(P-1 条件④,2026-09-11 自 docs/SUBSYSTEM-SPI.md §13.2 迁入)。与 core/extension_loader.py parse_manifest 的校验逐条对应;未知字段拒绝。",
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9_]+$", "description": "必须与扩展目录名一致。" },
        "version": { "type": "string", "minLength": 1, "description": "扩展自身版本(与宿主/协议版本无关)。" },
        "language": { "enum": ["python", "other"] },
        "entry": { "type": "string", "minLength": 1, "description": "language=python 必填;相对 manifest 目录且不得越出。" },
        "transport": { "enum": ["stdio"], "description": "language=other 必填且必须 stdio。" },
        "command": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "language=other 必填。" },
        "protocol_version": { "$ref": "#/definitions/ProtocolVersion" },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/definitions/Capability" },
          "description": "必填(可空)。代码类声明必须 ⊆ 本授权面。"
        },
        "description": { "type": "string" },
        "requirements": { "type": "array", "items": { "type": "string" }, "description": "仅文档声明,宿主不自动安装。" },
        "kind": { "enum": ["branch", "host-component"], "description": "缺省 branch;host-component 见 P-6。" },
        "slots": { "type": "array", "items": { "type": "string" }, "description": "host-component 必填非空;branch 禁止。" }
      },
      "required": ["name", "version", "language", "capabilities"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "language": { "const": "python" } }, "required": ["language"] },
          "then": { "required": ["entry"], "not": { "required": ["transport"] } }
        },
        {
          "if": { "properties": { "language": { "const": "other" } }, "required": ["language"] },
          "then": { "required": ["transport", "command"], "not": { "required": ["entry"] } }
        },
        {
          "if": { "properties": { "kind": { "const": "host-component" } }, "required": ["kind"] },
          "then": {
            "required": ["slots"],
            "properties": {
              "language": { "const": "other" },
              "transport": { "const": "stdio" },
              "capabilities": { "maxItems": 0 }
            }
          }
        }
      ]
    },
    "Extension": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "description": "扩展名, 与 types 域 extension_name 约束一致。"
        },
        "lang": { "type": "string" },
        "transport": { "$ref": "#/definitions/TransportType" },
        "protocol_version": { "$ref": "#/definitions/ProtocolVersion" },
        "hooks_implemented": {
          "type": "array",
          "items": { "type": "string" },
          "description": "声明实现哪些钩子, core 只调用已声明的。"
        },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/definitions/Capability" },
          "description": "能力声明集合(扩展→宿主)。缺省(空集)=策略/工具类, 可正常返回 action。"
        }
      },
      "required": ["name", "lang", "transport", "protocol_version", "hooks_implemented", "capabilities"],
      "additionalProperties": false
    },
    "HostCapabilities": {
      "type": "object",
      "description": "宿主能力声明(宿主→扩展, setup 第二参 host 的内容)。纯数据声明, 非对象引用。",
      "properties": {
        "protocol_domains": {
          "type": "array",
          "items": { "type": "string" }
        },
        "storage": {
          "type": "object",
          "properties": {
            "channel": { "const": "transport.storage_*" },
            "kind_prefix": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$",
              "description": "该扩展的 kind 命名空间前缀 '{extension_name}.'。"
            }
          },
          "required": ["channel", "kind_prefix"],
          "additionalProperties": false
        }
      },
      "required": ["protocol_domains", "storage"],
      "additionalProperties": false
    }
  }
}
