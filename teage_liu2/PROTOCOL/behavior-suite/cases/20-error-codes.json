{
  "id": "error-codes-20",
  "protocol_version": "v1.0.0",
  "description": "错误码锚定(§errors §6 三面模型): 按 scenarios 驱动 HOOK_EXCEPTION / HOOK_TERMINAL_ACTION_IGNORED / TOOL_NO_EXECUTOR / LOOP_MAX_REACHED / LLM_TIMEOUT / LLM_CANCELED / LLM_STREAM_FAILED / LLM_API_ERROR / STORAGE_WRITE_FAILED 九条真实发射路径 —— 日志面经 logging 捕获断言 `CODE: message` 前缀,事件面经 `custom:error_matrix` 汇总各场景 `error` 事件 code 断言(LLM_CANCELED 属事件面①,用户取消时 info 级日志不入 warning+ 捕获,故只经事件面锚定)。",
  "setup": {
    "extensions": []
  },
  "inputs": {
    "session_id": "s-20",
    "max_loops": 3,
    "scenarios": [
      { "kind": "raise_on", "hook": "before" },
      { "kind": "terminal_action" },
      { "kind": "tool_path_no_executor" },
      { "kind": "loop_max" },
      { "kind": "llm_error", "code": "LLM_TIMEOUT" },
      { "kind": "llm_error", "code": "LLM_CANCELED" },
      { "kind": "llm_error", "code": "LLM_STREAM_FAILED" },
      { "kind": "llm_error", "code": "LLM_API_ERROR" },
      { "kind": "storage_write_fail" }
    ]
  },
  "expected": {
    "error_codes": {
      "must_include": [
        "HOOK_EXCEPTION",
        "HOOK_TERMINAL_ACTION_IGNORED",
        "TOOL_NO_EXECUTOR",
        "LOOP_MAX_REACHED",
        "LLM_TIMEOUT",
        "LLM_CANCELED",
        "LLM_STREAM_FAILED",
        "LLM_API_ERROR",
        "STORAGE_WRITE_FAILED"
      ],
      "must_exclude": []
    }
  }
}
